# ---- Shared ----
NODE_ENV=development

# ---- API (api/) ----
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://mboni:mboni@localhost:5432/mboni
REDIS_URL=redis://localhost:6379
# Production Compose requires a URL-safe password (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=replace-with-a-random-production-password
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Brevo transactional email (leave empty in dev: emails are printed to the API log)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Mboni
CONTACT_INBOX=malostechnologies@gmail.com

# ImageKit (avatars). Leave empty to disable uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional AI presentation planner. Empty = deterministic rule-based planner.
ANTHROPIC_API_KEY=
PLANNER_MODEL=

# Python model service (FastAPI). Local: http://127.0.0.1:8000 · Compose: http://model:8000
MODEL_URL=http://127.0.0.1:8000
# Fall back to in-process sample engine if model is unreachable (true/false)
MODEL_FALLBACK=true

# ---- Web (web/) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CONTACT_EMAIL=malostechnologies@gmail.com
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
