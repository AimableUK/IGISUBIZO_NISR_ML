# ---- Shared ----
NODE_ENV=development

# ---- API (api/) ----
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://isesengura:isesengura@localhost:5432/isesengura
REDIS_URL=redis://localhost:6379
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Brevo transactional email (leave empty in dev: emails are printed to the API log)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Isesengura
CONTACT_INBOX=team@example.com

# ImageKit (avatars). Leave empty to disable uploads.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional AI presentation planner. Empty = deterministic rule-based planner.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-5-5

# ---- Web (web/) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CONTACT_EMAIL=team@example.com
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
