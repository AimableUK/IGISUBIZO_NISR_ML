{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true, "types": ["node"],
    "baseUrl": ".", "paths": { "@shared": ["src/shared/index.ts"] }
  },
  "include": ["src"]
}
