{
  "name": "@raw/api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "prisma generate && tsup",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.9",
    "better-auth": "^1.3.4",
    "bullmq": "^5.34.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "imagekit": "^6.0.0",
    "ioredis": "^5.4.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "prisma": "^6.1.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.9",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "msgpackr-extract"
    ]
  }
}
